# ─────────────────────────────────────────────────────────────
# Seasonal Sports Hub — environment variables
# Copy to `.env` for local dev. On Vercel, set these in
# Project → Settings → Environment Variables (Postgres & Blob
# variables are added automatically when you create those stores).
# ─────────────────────────────────────────────────────────────

# Vercel Postgres (Neon). Created automatically when you add a
# Postgres store to your Vercel project. Locally, paste the
# "postgres://..." connection string from the store's .env tab.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Vercel Blob. Created automatically when you add a Blob store.
# Locally, paste the token from the store's .env tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Secret used to sign login session cookies (JWT). Use a long
# random string. Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: email address that is auto-promoted to admin on
# first sign-up (handy for bootstrapping the first admin).
ADMIN_EMAIL=""
